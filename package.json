{
  "name": "xunfei-job-assistant",
  "version": "1.1.0",
  "description": "Local-first Windows job-search assistant for Chinese-speaking users",
  "main": "electron/main.js",
  "author": "mili-xi and contributors",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "npm run test:electron",
    "test:electron": "node --test electron/*.test.js",
    "test:python": ".\\.venv\\Scripts\\python.exe -m unittest discover -s tests -v",
    "verify:packaging-context": "node electron/packagingPolicy.js",
    "lint": "npm run lint:python && npm run lint:types",
    "lint:python": ".\\.venv\\Scripts\\python.exe -m ruff check .",
    "lint:types": "pyright",
    "verify": "npm run test:electron && npm run test:python && npm run lint && npm run verify:packaging-context",
    "pack": "electron-builder --win dir",
    "dist": "node electron/buildInstaller.js",
    "dist:zip": "electron-builder --win zip"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@electron/asar": "4.2.1",
    "7zip-bin": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "pyright": "1.1.411",
    "yaml": "2.9.0"
  },
  "build": {
    "appId": "com.xunfei.jobassistant",
    "productName": "Xunfei Job Assistant",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*.js",
      "electron/settings/**/*",
      "!electron/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "前端",
        "to": "app-resources/frontend"
      },
      {
        "from": "后端",
        "to": "app-resources/backend"
      },
      {
        "from": "runtime",
        "to": "app-resources/runtime"
      },
      {
        "from": "requirements.txt",
        "to": "app-resources/requirements.txt"
      }
    ],
    "win": {
      "icon": "build/app-icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/app-icon.ico",
      "uninstallerIcon": "build/app-icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerHeaderIcon": "build/app-icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "shortcutName": "Xunfei Job Assistant",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    }
  }
}
